{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["ruleset_id", "protocol_version", "plugin_api_version", "simulation_version", "save_version", "tick_rate", "packs"],
  "properties": {
    "ruleset_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$"},
    "protocol_version": {"type": "integer", "const": 1},
    "plugin_api_version": {"type": "integer", "const": 1},
    "simulation_version": {"type": "integer", "const": 1},
    "save_version": {"type": "integer", "const": 1},
    "tick_rate": {"type": "integer", "minimum": 1, "maximum": 240},
    "packs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^packs/[a-z][a-z0-9-]*/manifest\\.json$"}}
  },
  "additionalProperties": false
}
