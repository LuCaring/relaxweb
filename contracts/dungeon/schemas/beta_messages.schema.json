{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dungeon Beta permanent-operation messages (protocol_version 1)",
  "description": "Frozen shapes for the registered permanent Beta requests, camp state, shared envelopes, and invalidation push.",
  "$defs": {
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,96}$"},
    "protocol_version": {"type": "integer", "const": 1},
    "get_state_request": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id"],
      "properties": {
        "type": {"const": "dungeon_beta_get_state"},
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "request_id": {"$ref": "#/$defs/request_id"}
      },
      "additionalProperties": false
    },
    "state_item": {
      "type": "object",
      "required": ["item_id", "template_id", "template_version", "display_name", "visual_id", "slot", "quality", "stats", "tags", "legacy_effects", "affixes", "sell_coins", "locked", "location", "version", "upgrade_level", "bound_reason", "source", "ruleset_id", "ruleset_hash", "effects", "template_trade_allowed", "can_trade", "reservation"],
      "properties": {
        "item_id": {"$ref": "#/$defs/request_id"},
        "template_id": {"type": "string", "minLength": 1},
        "template_version": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "visual_id": {"type": "string", "minLength": 1},
        "slot": {"type": "string", "minLength": 1},
        "quality": {"type": "string", "minLength": 1},
        "stats": {"type": "object"},
        "tags": {"type": "array"},
        "legacy_effects": {"type": "array"},
        "affixes": {"type": "array"},
        "sell_coins": {"type": "integer", "minimum": 0},
        "locked": {"type": "boolean"},
        "location": {"enum": ["bag", "pending"]},
        "version": {"type": "integer", "minimum": 1},
        "upgrade_level": {"type": "integer", "minimum": 0},
        "bound_reason": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]},
        "ruleset_id": {"type": ["string", "null"]},
        "ruleset_hash": {"type": ["string", "null"]},
        "effects": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "trigger", "params"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "trigger": {"type": "string"}, "params": {"type": "object"}}}},
        "template_trade_allowed": {"type": ["boolean", "null"]},
        "can_trade": {"type": "boolean"},
        "reservation": {"type": ["object", "null"], "required": ["purpose", "ref"], "properties": {"purpose": {"enum": ["active_run", "trade_offer"]}, "ref": {"type": "string"}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "get_state_result": {
      "type": "object",
      "required": ["ruleset", "wallet", "bag_capacity", "profile_version", "items", "pending_count", "loadout", "progress", "materials", "asset_revision", "active_run"],
      "properties": {
        "ruleset": {"type": "object", "required": ["ruleset_id", "ruleset_hash", "protocol_version", "simulation_version", "save_version"], "properties": {"ruleset_id": {"type": "string"}, "ruleset_hash": {"type": "string"}, "protocol_version": {"type": "integer"}, "simulation_version": {"type": "integer"}, "save_version": {"type": "integer"}}},
        "wallet": {"type": "object", "required": ["coin_minor"], "properties": {"coin_minor": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
        "bag_capacity": {"type": "integer", "minimum": 1},
        "profile_version": {"type": ["integer", "null"], "minimum": 1},
        "items": {"type": "array", "items": {"$ref": "#/$defs/state_item"}},
        "pending_count": {"type": "integer", "minimum": 0},
        "loadout": {"type": "object", "additionalProperties": {"$ref": "#/$defs/request_id"}},
        "progress": {"type": "array", "items": {"type": "string"}},
        "materials": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "asset_revision": {"type": "integer", "minimum": 1},
        "active_run": {"type": ["object", "null"], "required": ["run_id", "route_id", "status", "room_index", "server_tick", "durable_tick", "run_revision", "control_epoch", "ruleset_id", "ruleset_hash"]}
      },
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "required": ["resource_id", "amount"],
      "properties": {
        "resource_id": {"type": "string", "minLength": 1},
        "amount": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "get_catalog_request": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id"],
      "properties": {
        "type": {"const": "dungeon_beta_get_catalog"},
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "request_id": {"$ref": "#/$defs/request_id"}
      },
      "additionalProperties": false
    },
    "quote_upgrade_request": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id", "item_id", "target_level"],
      "properties": {
        "type": {"const": "dungeon_beta_quote_upgrade"},
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "item_id": {"$ref": "#/$defs/request_id"},
        "target_level": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "upgrade_request": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id", "item_id", "target_level", "expected_item_version", "expected_ruleset_id", "expected_costs"],
      "properties": {
        "type": {"const": "dungeon_beta_upgrade"},
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "item_id": {"$ref": "#/$defs/request_id"},
        "target_level": {"type": "integer", "minimum": 0},
        "expected_item_version": {"type": "integer", "minimum": 1},
        "expected_ruleset_id": {"type": "string", "minLength": 1},
        "expected_costs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cost"}}
      },
      "additionalProperties": false
    },
    "create_offer_request": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id", "item_id", "expected_item_version", "buyer_id", "price_minor", "expected_trade_policy_version", "expected_fee_minor"],
      "properties": {
        "type": {"const": "dungeon_beta_create_offer"},
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "item_id": {"$ref": "#/$defs/request_id"},
        "expected_item_version": {"type": "integer", "minimum": 1},
        "buyer_id": {"type": "integer", "minimum": 1},
        "price_minor": {"type": "integer", "minimum": 1},
        "expected_trade_policy_version": {"type": "integer", "minimum": 1},
        "expected_fee_minor": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "accept_offer_request": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id", "offer_id", "expected_offer_version"],
      "properties": {
        "type": {"const": "dungeon_beta_accept_offer"},
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "offer_id": {"$ref": "#/$defs/request_id"},
        "expected_offer_version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "cancel_offer_request": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id", "offer_id", "expected_offer_version"],
      "properties": {
        "type": {"const": "dungeon_beta_cancel_offer"},
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "offer_id": {"$ref": "#/$defs/request_id"},
        "expected_offer_version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "list_offers_request": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id"],
      "properties": {
        "type": {"const": "dungeon_beta_list_offers"},
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "request_id": {"$ref": "#/$defs/request_id"}
      },
      "additionalProperties": false
    },
    "get_receipt_request": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id", "lookup_request_id"],
      "properties": {
        "type": {"const": "dungeon_beta_get_receipt"},
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "lookup_request_id": {"$ref": "#/$defs/request_id"}
      },
      "additionalProperties": false
    },
    "result_envelope": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id", "result_kind", "result"],
      "properties": {
        "type": {"const": "dungeon_beta_result"},
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "result_kind": {"type": "string", "minLength": 1},
        "replayed": {"type": "boolean"},
        "asset_revision": {"type": "integer", "minimum": 1},
        "result": {"type": "object"}
      },
      "additionalProperties": false
    },
    "error_envelope": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id", "code", "message", "retryable", "details"],
      "properties": {
        "type": {"const": "dungeon_beta_error"},
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "request_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,96}$"},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    },
    "invalidate_push": {
      "type": "object",
      "required": ["type", "protocol_version"],
      "properties": {
        "type": {"const": "dungeon_beta_invalidate"},
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "asset_revision": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
