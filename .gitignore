# =========================================================
# 运行期数据与用户数据：绝不入库
# =========================================================
# 数据库（含用户、密码哈希、会话、金币流水）
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
users.db*

# 日志与调试输出
*.log
*.out
logs/

# 本地配置（含推流口令等）：仓库里只保留 config.example.json
config.json
config.*.local.json
assets/estate/characters/local_*/
.env
.env.*

# 证书与私钥
*.pem
*.key
*.p12
*.pfx

# 上传/导出目录
uploads/
exports/

# =========================================================
# 运行时缓存与编辑器产物
# =========================================================
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.DS_Store
Thumbs.db
*.swp
*~

# 本地编辑器与个人工作区配置
.cursor/
.idea/
.vscode/
.claude/
.codex/
.zcodeignore
*.code-workspace

# =========================================================
# 仓库结构相关
# =========================================================
# 测试子仓库通过 git submodule 引用（自己的仓库 + 自己的提交历史）
# live-test 目录由 .gitmodules 管理，不在这里忽略

# 早期手工备份快照
*.backup
*.save
*.before-*
